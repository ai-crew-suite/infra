# ==========================================================================
# 1. System & OS Artifacts
# ==========================================================================
.classpath
.DS_Store
.DS_Store?
.idea/
.project
.settings/
*.sublime-project
*.sublime-workspace
ehthumbs.db
Log.txt
Thumbs.db

# ==========================================================================
# 2. Local Configuration & Environment Files
# ==========================================================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.sqlite
.clinerules
packages/app-config/*.local.yaml

# ==========================================================================
# 3. Build Outputs & Compiled Code (Scoped Globally via Wildcards)
# ==========================================================================
**/dist/
**/dist-types/
**/*.tsbuildinfo
**/.turbo
.command-cache/
artifacts/

# ==========================================================================
# 4. Yarn 4 Configuration Boundaries
# ==========================================================================
**/node_modules/
.yarn/install-state.gz
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml

# NEVER ignore these critical Yarn orchestration and development files
!.yarn/patches/
!.yarn/plugins/
!.yarn/releases/
!.yarn/sdks/

# ==========================================================================
# 5. Testing, Verification, & Runtime Python Environments
# ==========================================================================
.venv
.pnp.*
.eslintcache
.stylelintcache
.prettiercache
coverage/
cypress/videos/
cypress/screenshots/
playwright-report/
test-results/
**/.vitest-cache

# ==========================================================================
# 6. Terraform Artifacts
# ==========================================================================
**/.terraform/
*.tfstate
*.tfstate.backup
*.tfvars
*.tfvars.json
.terraform.lock.hcl
